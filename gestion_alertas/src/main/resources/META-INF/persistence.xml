<?xml version="1.0" encoding="UTF-8"?>

<persistence
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
    version="3.2">

    <persistence-unit
        name="AlertasPU"
        transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entidades terminadas -->
        <class>ec.monitoreo.alertas.Alerta</class>
        <class>ec.monitoreo.alertas.DetalleTecnico</class>
        <class>ec.monitoreo.alertas.RelacionAlerta</class>
        <class>ec.monitoreo.alertas.Seguimiento</class>

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>

            <!-- Conexión a PostgreSQL -->
            <property
                name="jakarta.persistence.jdbc.driver"
                value="org.postgresql.Driver"/>

            <property
                name="jakarta.persistence.jdbc.url"
                value="jdbc:postgresql://localhost:5432/bd_grupociberdefensa"/>

            <property
                name="jakarta.persistence.jdbc.user"
                value="postgres"/>

            <property
                name="jakarta.persistence.jdbc.password"
                value="CONFIGURAR_CLAVE_LOCAL"/>

            <!-- Esquema -->
            <property
                name="hibernate.default_schema"
                value="public"/>

            <!-- Actualizar tablas durante la práctica -->
            <property
                name="hibernate.hbm2ddl.auto"
                value="update"/>

            <!-- Detener el inicio si falla la actualización -->
            <property
                name="hibernate.hbm2ddl.halt_on_error"
                value="true"/>

            <!-- Mostrar SQL en la salida de NetBeans -->
            <property
                name="hibernate.show_sql"
                value="true"/>

            <property
                name="hibernate.format_sql"
                value="true"/>

        </properties>

    </persistence-unit>

</persistence>